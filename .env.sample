#Atlas webapi confi
DATASOURCE_URL=jdbc:postgresql://omop-bridge-db:5432/omop_cdm?currentSchema=webapi
DATASOURCE_USERNAME=omop
DATASOURCE_PASSWORD=omop
DATASOURCE_OHDSI_SCHEMA=webapi
SPRING_BATCH_REPOSITORY_TABLEPREFIX=webapi.batch_
SPRING_FLYWAY_TABLE=flyway_schema_history
SPRING_FLYWAY_BASELINE_VERSION=3.0.0
FLYWAY_BASELINE_VERSION=3.0.0
SPRING_FLYWAY_REPAIR_ON_MIGRATE=true
SECURITY_CORS_ENABLED=true
SECURITY_CORS_ALLOWED_ORIGINS=http://localhost,https://localhost
SECURITY_AUTH_DB_ENABLED=true
SECURITY_AUTH_WINDOWS_ENABLED=false
SECURITY_AUTH_KERBEROS_ENABLED=false
SECURITY_AUTH_OIDC_ENABLED=false
SECURITY_AUTH_OAUTH_FACEBOOK_ENABLED=false
SECURITY_AUTH_OAUTH_GITHUB_ENABLED=false
SECURITY_AUTH_OAUTH_GOOGLE_ENABLED=false
SECURITY_AUTH_LDAP_ENABLED=false
SECURITY_AUTH_AD_ENABLED=false
SECURITY_AUTH_CAS_ENABLED=false
# OAuth callbacks
SECURITY_AUTH_OAUTH_CALLBACK_UI=http://localhost/atlas/#/oauth/callback
SECURITY_AUTH_OAUTH_CALLBACK_API=http://localhost:8080/WebAPI/user/oauth/callback
# TrexSQL
TREXSQL_ENABLED=true
TREXSQL_CACHE_PATH=/data/cache
HOME=/data
AWS_REGION=us-east-1
BAO_AGENT_MODEL=minimax.minimax-m2.5
#Target Postgres Config
TARGET_DB_HOST=omop-bridge-db
TARGET_DB_PORT=5432
TARGET_DB_USER=omop
TARGET_DB_PASSWORD=omop
TARGET_DB_NAME=omop_cdm
CDM_SCHEMA=cdm
VOCAB_SCHEMA=vocab
RESULTS_SCHEMA=results
RESULTS_DIR='/results'
CDM_SOURCE_NAME='OMOP Bridge'
SHINY_HOST=0.0.0.0
SHINY_PORT=3000
DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver
#AI matching
AUTO_ACCEPT_CONFIDENCE=0.85
CONCEPT_CANDIDATE_LIMIT=15
HF_TOKEN=
#Authentication
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=720
# Default server name
NGINX_SERVER_NAME=localhost
#DQD
R_RUNNER_URL=http://r-runner:8001
#Frontend
VITE_API_BASE_URL=""
#Docker Images pushed to GHCR
DB_IMAGE=ghcr.io/omop-bridge/omop-bridge/omop-bridge-db:latest
BACKEND_IMAGE=ghcr.io/omop-bridge/omop-bridge/omop-bridge-backend:latest
R_RUNNER_IMAGE=ghcr.io/omop-bridge/omop-bridge/omop-bridge-r-runner:latest
FRONTEND_IMAGE=ghcr.io/omop-bridge/omop-bridge/omop-bridge-frontend:latest
WEBAPI_IMAGE=ghcr.io/omop-bridge/ohdsi-atlas3/omop-bridge-atlas3-webapi:latest
ATLAS_FRONTEND_IMAGE=ghcr.io/omop-bridge/ohdsi-atlas3/omop-bridge-atlas3-frontend:latest



#FHIR pick preferred coding.system first from the fhir resources
GLOCAL_PREFERRED_TERMINOLOGY_SYSTEMS=http://terminology.hl7.org,cielterminology.org,cielterminology.org,ciel,loinc.org,snomed.info,icd-10,rxnorm
OBSERVATION_CODE_PREFERRED_SYSTEMS=ciel,cielterminology.org,loinc.org,snomed.info
OBSERVATION_VALUE_CONCEPT_PREFERRED_SYSTEMS=snomed.info,ciel,cielterminology.org,loinc.org